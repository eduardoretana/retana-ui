  "typography": {
    "sans": { "$value": { "fontFamily": "var(--font-geist-sans)" } },
    "heading": { "$value": { "fontFamily": "var(--font-sans)" } },
    "mono": { "$value": { "fontFamily": "var(--font-geist-mono)" } }
  },
  "radius": {
    "base": { "$value": "0.625rem" },
    "sm": { "$value": "calc(var(--radius) * 0.6)" },
    "md": { "$value": "calc(var(--radius) * 0.8)" },
    "lg": { "$value": "var(--radius)" },
    "xl": { "$value": "calc(var(--radius) * 1.4)" },
    "2xl": { "$value": "calc(var(--radius) * 1.8)" },
    "3xl": { "$value": "calc(var(--radius) * 2.2)" },
    "4xl": { "$value": "calc(var(--radius) * 2.6)" }
  },
  "$extensions": {
    "retana.dark": { "derived": false },
    "retana.design": {
      "name": "Retana UI",
      "description": "Tema de demostración del catálogo. Las piezas heredan estos tokens y no traen marca propia.",
      "overview": "Los valores salen de app/globals.css (:root y .dark) y de las variables de fuente en app/layout.tsx. El color queda en oklch, tal como está escrito. El radio es el paso calc() sobre --radius 0.625rem. El oscuro está declarado token por token, no derivado.",
      "dos": [
        "Usar las clases semánticas del host (bg-background, text-foreground, bg-primary, bg-muted, rounded-lg).",
        "Dejar el color en el oklch de este archivo. No convertirlo a hex ni a rgb.",
        "Tomar el radio de un paso de este archivo (sm, md, lg, xl, 2xl, 3xl, 4xl)."
      ],
      "donts": [
        {
          "text": "No estirar la prosa al ancho de la pantalla. La columna de lectura se detiene.",
          "rule_id": "RUI-LAYOUT-WIDTH-001",
          "check": "manual"
        },
        {
          "text": "No apilar borde sobre borde. Separar con superficie, espacio o sombra del tema.",
          "rule_id": "RUI-LAYOUT-BORDER-001",
          "check": "manual"
        },
        {
          "text": "No usar color fuerte fuera de la acción primaria o el dato activo.",
          "rule_id": "RUI-LAYOUT-COLOR-001",
          "check": "manual"
        },
        {
          "text": "No pintar entero y decimales con el mismo peso.",
          "rule_id": "RUI-TYPE-HIERARCHY-001",
          "check": "test"
        },
        {
          "text": "No animar width, height ni usar transition-all. Solo transform y opacity.",
          "rule_id": "RUI-MOTION-CONTINUITY-001",
          "check": "test"
        },
        {
          "text": "No inventar un radio fuera de los pasos. Un círculo 1:1 es la excepción percent-circle.",
          "rule_id": "RUI-RADIUS-001",
          "check": "lint"
        },
        {
          "text": "No meter color literal en registry/.",
          "rule_id": "RUI-COLOR-001",
          "check": "lint"
        }
      ],
      "iteration_guide": "Editar rules/brand/retana-ui.tokens.json y regenerar ui/design/retana-ui/DESIGN.md con design_render.mjs. No editar DESIGN.md a mano. Verificar con --check.",
      "known_gaps": [
        "No hay tamaño, peso ni interlineado propios en app/globals.css. Solo existen los roles sans, heading y mono.",
        "No hay sombras verbatim en globals.css. shadow-sm y el resto salen del preset de Tailwind que trae shadcn, no de este archivo.",
        "No hay escala de spacing propia. El espacio usa la escala del preset.",
        ".review-preview y .ae-ember pisan primary y chart dentro de esas clases. No son tokens de marca y no están aquí.",
        "Ningún hueco de contraste medido en este archivo (2026-10-30, el render solo copia los valores)."
      ]
    }
  }
}
